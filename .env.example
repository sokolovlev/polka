# Local development settings for docker compose (deploy/compose/compose.yaml).
# `make up` copies this file to .env if .env does not exist. These values are
# for a local machine only; never reuse them anywhere else.

# Images that `make up` pulls: $POLKA_REGISTRY/polka-<service>:$POLKA_TAG.
# `make up-build` builds them locally with tag `local` instead.
POLKA_REGISTRY=ghcr.io/sokolovlev
POLKA_TAG=main

# Build info baked into locally built images (spec 9.1). `make` sets them from git.
POLKA_VERSION=dev
POLKA_COMMIT=unknown
LOG_LEVEL=info

# PostgreSQL superuser (used only by the init script).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-local

# One database owner per service (spec 7).
POLKA_AUTH_DB_PASSWORD=auth-local
POLKA_CATALOG_DB_PASSWORD=catalog-local
POLKA_ORDERS_DB_PASSWORD=orders-local
POLKA_INVENTORY_DB_PASSWORD=inventory-local
POLKA_PAYMENTS_DB_PASSWORD=payments-local
POLKA_NOTIFICATIONS_DB_PASSWORD=notifications-local

# S3 (SeaweedFS) credentials for catalog.
S3_ACCESS_KEY=polka
S3_SECRET_KEY=polka-local-secret
