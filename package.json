{
  "name": "polka",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "libs/ts/*",
    "services/notification",
    "web"
  ],
  "scripts": {
    "build:libs": "npm run build -w @polka/proto -w @polka/runtime",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "openapi:lint": "redocly lint gateway"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@redocly/cli": "2.78.0",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "prettier": "3.10.1",
    "ts-proto": "2.21.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
